# Anthropic API key (optional — if not set, OAuth login via browser is used)
ANTHROPIC_API_KEY=

# Per-session budget cap in USD. Applies only under API-key billing
# (OAuth/subscription sessions are turn-limited). Overridden by --max-budget.
# ADMIN_AGENT_MAX_BUDGET=5.00

# Kinetica connection details (prompted interactively if not set)
# If password is omitted, the agent will prompt for it at startup
KINETICA_URL=
KINETICA_USER=
KINETICA_PASS=

# Strict HTTPS mode — when set to 1, the agent refuses to fall back to
# plaintext HTTP after a failed HTTPS probe. Recommended for production.
# KINETICA_HTTPS_ONLY=1

# Observability (optional) — Prometheus / Loki.
# Normally discovered automatically from gpudb.conf's gaia.event_server_address, and no
# setting is needed when the agent runs anywhere that routes the cluster's network.
# Set this only when that address is unreachable from where you run the agent — common,
# since a kagent install declares an INTERNAL address. One host covers both services:
# Prometheus is derived at :9090 and Loki at gaia.event_server_port (default :9080).
# Startup tells you when it found a declared endpoint it could not reach.
KINETICA_STATS_HOST=
